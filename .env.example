# SQLite database file
DB_PATH=notifier.db

# Locale used for a backend when none is provided (BCP 47, e.g. en, ar, en-US)
DEFAULT_LOCALE=en
# Worker goroutines per backend when none is provided (must be > 0)
DEFAULT_WORKER_COUNT=1

# Cipher used for FCM credentials: aes-gcm | chacha20-poly1305
ENCRYPTION_ALGORITHM=aes-gcm
# Base64 32-byte keys; only the selected algorithm's key is required.
# Generate with: openssl rand -base64 32
AES_GCM_KEY=
CHACHA20_POLY1305_KEY=
